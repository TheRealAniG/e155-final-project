# Radiant implementation output
/radiant/impl_*/

# Local Radiant session files
/radiant/.build_status
/radiant/.run_manager.ini
/radiant/.recovery
/radiant/.spread_sheet.ini
/radiant/.spreadsheet_view.ini
/radiant/*.log
/radiant/*.dir/

# Simulation output when run from FPGA/sim/
sim/work/
/sim/transcript
/sim/vsim.
# Generated Questa outputs
/radiant/*_sim/qrun.out/
/radiant/*_sim/*.wlf
/radiant/*_sim/transcript
/radiant/*_sim/*.ppm
/radiant/transcript

# Simulator artifacts, including sprite_rotate and other simulation folders.
# Keep RTL, assets, project definitions and simulation launch files tracked.
**/qrun.out/
**/work/
**/transcript
*.wlf
*.vcd
*.vvp
*.ppm
*.log
/radiant/.ng_run_manager.ini
/radiant/.setting.ini
/radiant/reportview.xml
/radiant/*_tcl.html
/radiant/**/*.sort
/radiant/**/*.tops
/radiant/**/source_files.lst
/radiant/**/sim_para.tcl
